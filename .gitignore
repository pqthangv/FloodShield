# Root-level ignores (each project has its own .gitignore too)
*.zip
*.aab
*.apk
.DS_Store
Thumbs.db
.vscode/
# Python's caches, anywhere (scripts/, mobile/.maestro/; backend/ has its own rule)
__pycache__/
docs/screenshots/raw/
deploy/.env

# Personal notes, store listings and signing / push keys: never commit
private/
*.p8
*.p12
*.cer
*.mobileprovision
*firebase-adminsdk*.json
