# Copy to .env and adjust. All values are optional for local development.

# SQLite (default) or PostgreSQL, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./store.db

# Long random string; enables /api/v1/admin/* (create alerts & shelters, moderate posts).
ADMIN_TOKEN=

# Public URL of the deployed API, used for photo links. Leave empty locally; on Render it
# defaults to the service's own URL (RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=

# Contact address shown in the privacy policy and sent to OpenStreetMap (their usage policy requires it).
CONTACT_EMAIL=
