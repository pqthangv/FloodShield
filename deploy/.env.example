# Copy to deploy/.env on the server and fill in. deploy/.env is ignored by git: never commit it.

# Your free DuckDNS name (https://www.duckdns.org), pointing to the server's public IP.
DOMAIN=floodshield-yourname.duckdns.org

# Neon connection string (Neon > Connect > branch "production", pooling off). Paste as is.
DATABASE_URL=

# Long random string for the admin endpoints. setup.sh fills one in if this is empty.
ADMIN_TOKEN=

# Contact address sent to OpenStreetMap and MET Norway, as their usage policies require.
CONTACT_EMAIL=
