<?xml version="1.0" encoding="utf-8"?>
<!-- The 4 x 2 widget's warning band, in widget_medium.xml and widget_medium_narrow.xml. The
     default is neutral on purpose: never "all clear" before a real check. Two lines rather than
     cutting a warning (or Vietnamese's long "all clear") off mid-word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_band"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_band_unknown"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_band_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_band_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="@string/widget_open_app"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
