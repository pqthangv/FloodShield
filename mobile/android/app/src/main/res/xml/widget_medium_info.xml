<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 2, and people can resize it: the layout for each size is picked in WidgetState.kt
     (layoutFor). updatePeriodMillis (30 min, the shortest Android allows) redraws it from the saved
     snapshot without internet, so an old check turns neutral by itself (WidgetState.kt). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_medium_description"
    android:initialLayout="@layout/widget_medium"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_medium"
    android:minResizeWidth="220dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
