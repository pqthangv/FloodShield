<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (rain warnings). APS_ENVIRONMENT comes from the Xcode project: development
	     for Debug builds, production for Release builds (TestFlight and the App Store). -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- The box shared with the home-screen widget (FloodShieldWidget/), where the app saves what
	     it shows (FSAlertScheduler.mm). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.floodshield.app</string>
	</array>
</dict>
</plist>
